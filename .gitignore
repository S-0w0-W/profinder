# Ignore local environment files and secrets used by the app and Docker.
.env
.env.*
!.env.example

# Ignore the local Docker Compose file used for development setup.
docker-compose.yaml

# Ignore installed dependencies and package directories generated by npm/pnpm/yarn.
node_modules/
**/node_modules/
packages/
**/packages/

# Ignore build and generated output folders from the frontend/backend.
dist/
build/
.tmp/
coverage/

# Ignore Air's generated temporary binary used for Go live reload.
tmp/
